# API (apps/api/.env)
DATABASE_URL=postgresql://brewlite:brewlite@localhost:5432/brewlite
JWT_SECRET=change-me
PORT=3001
CORS_ORIGIN=https://localhost:3000
# HTTPS local: dùng chứng chỉ do 'pnpm dev' của web tạo ra (apps/web/certificates)
SSL_KEY=../web/certificates/localhost-key.pem
SSL_CERT=../web/certificates/localhost.pem

# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=https://localhost:3001
